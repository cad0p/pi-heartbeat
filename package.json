{
  "name": "@cad0p/pi-heartbeat",
  "version": "0.0.1",
  "description": "Non-blocking timers and heartbeats for pi agents — stop using sleep",
  "author": "Marc Fargas",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/cad0p/pi-heartbeat.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi",
    "pi-package",
    "agent",
    "timer",
    "heartbeat",
    "cron",
    "non-blocking",
    "polling"
  ],
  "files": [
    "src/**/*.ts",
    "skills/**/*.md",
    ".well-known/**",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "@cad0p/pi-background-work": ">=0.0.1-20261028.1 <0.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ __tests__/",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@eslint/js": "^9.27.0",
    "@marcfargas/pi-test-harness": "^0.4.1",
    "@sinclair/typebox": "^0.34.0",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
